<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Module category                                              -->
    <!-- ============================================================ -->
    <record id="module_category_respondio" model="ir.module.category">
        <field name="name">Respond.io</field>
        <field name="description">Respond.io CRM Bridge integration</field>
        <field name="sequence">200</field>
    </record>

    <!-- ============================================================ -->
    <!-- Security groups                                              -->
    <!-- ============================================================ -->
    <record id="group_respondio_readonly" model="res.groups">
        <field name="name">Respond.io Read-only</field>
        <field name="category_id" ref="module_category_respondio"/>
        <field name="comment">Can view respond.io data but cannot modify anything.</field>
    </record>

    <record id="group_respondio_sales" model="res.groups">
        <field name="name">Respond.io Sales User</field>
        <field name="category_id" ref="module_category_respondio"/>
        <field name="implied_ids" eval="[(4, ref('group_respondio_readonly'))]"/>
        <field name="comment">Can interact with respond.io integration (send messages, create activities).</field>
    </record>

    <record id="group_respondio_admin" model="res.groups">
        <field name="name">Respond.io Administrator</field>
        <field name="category_id" ref="module_category_respondio"/>
        <field name="implied_ids" eval="[(4, ref('group_respondio_sales'))]"/>
        <field name="comment">Full access including API tokens, webhook secrets, and configuration.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record rules                                                 -->
    <!-- ============================================================ -->

    <!-- Account: only admin can see/edit -->
    <record id="rule_respondio_account_admin" model="ir.rule">
        <field name="name">Respond.io Account — Admin only</field>
        <field name="model_id" ref="model_respondio_account"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_respondio_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Event log: admin can do everything, sales/readonly can read -->
    <record id="rule_respondio_event_log_admin" model="ir.rule">
        <field name="name">Respond.io Event Log — Admin full</field>
        <field name="model_id" ref="model_respondio_event_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_respondio_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_respondio_event_log_readonly" model="ir.rule">
        <field name="name">Respond.io Event Log — Read-only</field>
        <field name="model_id" ref="model_respondio_event_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_respondio_readonly'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
