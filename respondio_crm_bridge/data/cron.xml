<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Cron: Retry failed webhook events                            -->
    <!-- ============================================================ -->
    <record id="cron_respondio_retry_failed_events" model="ir.cron">
        <field name="name">Respond.io: Retry Failed Events</field>
        <field name="model_id" ref="model_respondio_event_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="doall" eval="False"/>
    </record>

    <!-- ============================================================ -->
    <!-- Cron: Clean old event logs (> 90 days)                       -->
    <!-- ============================================================ -->
    <record id="cron_respondio_clean_old_logs" model="ir.cron">
        <field name="name">Respond.io: Clean Old Event Logs</field>
        <field name="model_id" ref="model_respondio_event_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_clean_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="doall" eval="False"/>
    </record>
</odoo>
