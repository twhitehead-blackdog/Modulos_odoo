<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Server action: Open lead in respond.io (contextual action)   -->
    <!-- ============================================================ -->
    <record id="action_server_open_respondio_from_lead" model="ir.actions.server">
        <field name="name">Open in Respond.io</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
if record.respondio_url:
    action = {"type": "ir.actions.act_url", "url": record.respondio_url, "target": "new"}
        </field>
    </record>
</odoo>
